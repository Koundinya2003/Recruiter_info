# ---------------------------------------------------------------------------
# Job Search & Outreach Workspace — example environment file
#
# Copy to `.env` and fill in. Never commit the real `.env`.
#   cp .env.example .env
#
# Every third-party integration below is OPTIONAL. The application runs the
# full workflow — search, validate, find contacts, track — with no API key at
# all. A source that needs credentials reports itself as unconfigured and is
# skipped with a visible reason, rather than being quietly replaced.
# ---------------------------------------------------------------------------

# --- Core -------------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO
# Human-readable logs are easier to read locally; set true for prod-style JSON.
LOG_JSON=false

# --- Database (required) ----------------------------------------------------
DATABASE_URL=postgresql+psycopg2://roi:roi@localhost:5432/roi

# --- API auth ---------------------------------------------------------------
# If set, every /api request must carry `X-API-Key: <value>`.
# Leave EMPTY for a local single-user install with no auth.
API_KEY=

# Identifies the single local user who owns the data.
OWNER_EMAIL=owner@localhost

# ---------------------------------------------------------------------------
# JOB SOURCES
# ---------------------------------------------------------------------------

# --- Adzuna (optional, recommended) -----------------------------------------
# The broadest source for non-remote roles, and the one that covers Indian
# metros properly. Free credentials: https://developer.adzuna.com/signup
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# --- The Muse (optional) ----------------------------------------------------
# Works with no key; a key raises the rate limit.
# https://www.themuse.com/developers/api/v2
THE_MUSE_API_KEY=

# --- USAJobs (optional) -----------------------------------------------------
# US federal postings. Free credentials: https://developer.usajobs.gov/apirequest/
# The user agent must be the email address you registered with.
USAJOBS_API_KEY=
USAJOBS_USER_AGENT=

# --- Key-free sources -------------------------------------------------------
# These need no credentials. Set any to false to stop querying it.
ENABLE_THE_MUSE=true
ENABLE_REMOTIVE=true
ENABLE_ARBEITNOW=true
ENABLE_JOBICY=true
ENABLE_COMPANY_BOARDS=true

# Greenhouse / Lever / Ashby boards searched when a query names no companies.
# Defaults to app/data/company_boards.json — edit that file, or point this at
# your own. Every entry is probed against the live API before it is used.
COMPANY_BOARDS_FILE=

# ---------------------------------------------------------------------------
# SEARCH BEHAVIOUR
# ---------------------------------------------------------------------------

# Postings kept per search.
SEARCH_RESULT_LIMIT=40
# Ignore postings older than this many days where the source reports a date.
SEARCH_MAX_AGE_DAYS=45
# Relevance (0-100) below which a posting is dropped as not matching the
# request. Raise for fewer, closer matches.
SEARCH_MIN_RELEVANCE=35

# Hard cap on postings put through a live validation fetch in one search.
# Each costs one request plus a politeness delay.
VALIDATION_MAX_JOBS=40
VALIDATION_TIMEOUT=15

# Hard cap on companies contact discovery will crawl in one search.
CONTACTS_MAX_COMPANIES=10
CONTACTS_MAX_PAGES_PER_COMPANY=4
# Skip re-crawling a company's pages if they were checked this recently.
CONTACTS_CACHE_HOURS=168

# --- AI (optional) ----------------------------------------------------------
# Used for ONE thing: helping to read a free-text search request. The rule-based
# parser runs first and works with no key; a model may only fill gaps the rules
# leave, never overwrite what they extracted. It never writes a message and is
# never the source of a job, a company or a contact.
# OpenAI-compatible endpoint — OpenRouter by default; any compatible base URL
# works (OpenAI, Together, a local vLLM/Ollama gateway, ...).
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet
AI_REQUEST_TIMEOUT=45
AI_MAX_TOKENS=700

# --- Email verification (optional) ------------------------------------------
# Checks that a published address is deliverable. Never sends anything.
# Providers: "dns" (default, local MX/syntax checks, no third party),
#            "null" (never checks, everything stays `not_checked`),
#            "http" (a third-party verification API, configured below).
EMAIL_VERIFICATION_PROVIDER=dns
EMAIL_VERIFICATION_API_KEY=
# Example for a generic REST verifier. `{email}` and `{api_key}` are substituted.
EMAIL_VERIFICATION_API_URL=
EMAIL_VERIFICATION_TIMEOUT=15

# --- Responsible fetching ---------------------------------------------------
# Identify yourself honestly. Include a contact URL or address.
CRAWLER_USER_AGENT=JobSearchWorkspace/1.0 (+https://example.com/bot; personal job-search tool)
# Seconds between requests to the same domain.
CRAWLER_DOMAIN_DELAY_SECONDS=1.0
CRAWLER_REQUEST_TIMEOUT=20
CRAWLER_MAX_RETRIES=2
# Hard cap on pages fetched per search.
CRAWLER_MAX_PAGES_PER_RUN=120
# Hard cap on response body size (bytes) — protects against decompression bombs.
CRAWLER_MAX_RESPONSE_BYTES=3000000
# Respect robots.txt. Leave true. Setting false is your legal responsibility.
CRAWLER_RESPECT_ROBOTS=true
# Allow fetching private/loopback IPs. MUST stay false outside of tests (SSRF).
CRAWLER_ALLOW_PRIVATE_NETWORKS=false

# --- API rate limiting ------------------------------------------------------
API_RATE_LIMIT_PER_MINUTE=240

# --- Frontend ---------------------------------------------------------------
API_BASE_URL=http://localhost:8000
